<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Weather</title>

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">

<style>
:root { --primary: #ff6fa5; }

/* Body and Background */
body {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    transition: 0.5s;
    background: linear-gradient(135deg, #a8edea, #fed6e3);
    overflow-x: hidden;
    position: relative;
}

/* Floating background animation */
body::before {
    content: "";
    position: absolute;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255,255,255,0.3) 10%, transparent 10%);
    background-size: 50px 50px;
    animation: moveBg 20s linear infinite;
    z-index: -1;
}
@keyframes moveBg { from { transform: translate(0,0); } to { transform: translate(-200px,-200px); } }

/* Clouds Animation */
.clouds {
    position: absolute;
    width: 100%;
    height: 200px;
    background: url("https://i.ibb.co/7rQp7wY/clouds.png");
    background-size: cover;
    animation: cloudMove 60s linear infinite;
    top: 0;
    opacity: 0.3;
}
@keyframes cloudMove { from { background-position: 0 0; } to { background-position: 1000px 0; } }

/* Container */
.container {
    background: rgba(255,255,255,0.8);
    backdrop-filter: blur(15px);
    padding: 25px;
    border-radius: 20px;
    width: 380px;
    text-align: center;
    box-shadow: 0 10px 40px rgba(0,0,0,0.2);
    z-index: 1;
    position: relative;
}

/* Input & Buttons */
input {
    width: 85%;
    padding: 10px;
    border-radius: 15px;
    border: none;
    margin-bottom: 10px;
    text-align: center;
}
button {
    padding: 8px 15px;
    border-radius: 20px;
    border: none;
    background: var(--primary);
    color: white;
    cursor: pointer;
    margin: 5px;
    transition: 0.3s;
}
button:hover { transform: scale(1.05); }

/* Weather Results */
.weather-icon { width: 70px; }
.temp { font-size: 30px; font-weight: bold; }
#forecast { display: flex; justify-content: space-between; margin-top: 15px; font-size: 12px; flex-wrap: wrap; }
.forecast-day { background: rgba(255,255,255,0.6); padding: 8px; border-radius: 10px; width: 60px; margin: 3px; }
.toggle { margin-top: 15px; cursor: pointer; }

/* Dark Mode */
body.dark { background: linear-gradient(135deg, #1e1e2f, #2b2b45); color: white; }
body.dark .container { background: rgba(40,40,60,0.8); color: white; }
</style>
</head>

<body>
<div class="clouds"></div>

<div class="container">
    <h1>🌸 Weather 🌸 </h1>
    <input type="text" id="locationInput" placeholder="Enter city..."><br>
    <button onclick="getWeather()">Check Weather</button>
    <button onclick="getLocationWeather()">📍 Use My Location</button>

    <div id="weatherResult"></div>
    <div id="forecast"></div>
    <div class="toggle" onclick="toggleDarkMode()">🌙 Toggle Dark Mode</div>
</div>

<script>
const apiKey = "00870ebdaa014650a5d174313261702";

/* Get weather by city input */
function getWeather() {
    const location = document.getElementById("locationInput").value;
    fetchWeather(location);
}

/* Get weather by GPS */
function getLocationWeather() {
    navigator.geolocation.getCurrentPosition(position => {
        const lat = position.coords.latitude;
        const lon = position.coords.longitude;
        fetchWeather(`${lat},${lon}`);
    });
}

/* Fetch Weather & Forecast */
function fetchWeather(query) {
    fetch(`https://api.weatherapi.com/v1/forecast.json?key=${apiKey}&q=${query}&days=5&aqi=no`)
    .then(res => res.json())
    .then(data => {
        if(data.error){
            document.getElementById("weatherResult").innerHTML = "Location not found 😢";
            document.getElementById("forecast").innerHTML = "";
            return;
        }

        const weather = data.current;
        const location = data.location;

        document.getElementById("weatherResult").innerHTML = `
            <h3>📍 ${location.name}, ${location.country}</h3>
            <img class="weather-icon" src="https:${weather.condition.icon}">
            <div class="temp">${weather.temp_c}°C</div>
            <p>${weather.condition.text}</p>
            <p>💧 Humidity: ${weather.humidity}%</p>
            <p>🌬 Wind: ${weather.wind_kph} kph</p>
        `;

        changeBackground(weather.condition.text);

        let forecastHTML = "";
        data.forecast.forecastday.forEach(day => {
            forecastHTML += `
            <div class="forecast-day">
                <p>${day.date.split("-")[2]}</p>
                <img src="https:${day.day.condition.icon}" width="30">
                <p>${day.day.avgtemp_c}°C</p>
            </div>`;
        });
        document.getElementById("forecast").innerHTML = forecastHTML;
    });
}

/* Background changes based on weather */
function changeBackground(condition){
    if(condition.includes("Sunny")) document.body.style.background = "linear-gradient(135deg,#fddb92,#d1fdff)";
    else if(condition.includes("Rain")) document.body.style.background = "linear-gradient(135deg,#4e73df,#1cc88a)";
    else if(condition.includes("Cloud")) document.body.style.background = "linear-gradient(135deg,#bdc3c7,#2c3e50)";
    else document.body.style.background = "linear-gradient(135deg,#a8edea,#fed6e3)";
}

/* Dark Mode Toggle */
function toggleDarkMode() {
    document.body.classList.toggle("dark");
}
</script>
</body>
</html>
